# 复制为 keystore.properties 并填好；CI 里由 GitHub Secrets 自动生成该文件。
# ⚠️ 这个 keystore 就是给用户分发用的那一把，**必须离线备份**（连同口令），
#    丢了就无法覆盖升级，用户只能卸载重装。
#
# 生成（已经生成过一次，见 README「签名密钥」）：
#   keytool -genkeypair -v -keystore app-release.jks -storetype PKCS12 \
#           -alias songci -keyalg RSA -keysize 4096 -sigalg SHA256withRSA \
#           -validity 10000
#
# 查看证书指纹（发布包核对用）：
#   keytool -list -v -keystore app-release.jks
#   apksigner verify --print-certs app-release.apk
storeFile=app-release.jks
storePassword=改成你的口令
keyAlias=songci
keyPassword=改成你的口令
