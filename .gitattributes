# 统一换行符：Windows 上 core.autocrlf=true 时，gradlew 若变成 CRLF 会在
# Linux CI 上直接报 "/usr/bin/env: 'sh\r': No such file or directory"
* text=auto

# shell 脚本必须 LF
gradlew text eol=lf
*.sh text eol=lf

# Windows 批处理要 CRLF
*.bat text eol=crlf

# Python 工具统一 LF（跨平台执行更稳）
*.py text eol=lf

# 二进制：不要做任何转换
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.so binary

# 生成的文本文件：避免 diff 噪声
app/src/main/assets/verses.json -diff linguist-generated
